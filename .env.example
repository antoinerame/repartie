# Copie ce fichier en .env puis remplis les deux secrets.

# Mot de passe pour ouvrir le site.
APP_PASSWORD=

# Jeton secret pour Claude (MCP). Longue chaîne aléatoire, par exemple : openssl rand -hex 32
MCP_TOKEN=

# Port exposé sur la machine hôte.
PORT=3000

# 1 = crée un sujet d'exemple au premier lancement, 0 = démarre vide.
SEED_DEMO=1
